---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import ValueCard from "../components/ValueCard.astro";

const steps = [
  {
    step: "01",
    title: "Inputs are captured before execution",
    body: "Every run starts with defined instructions, context, files, observations, constraints, and operator intent — so the system knows what work was actually requested.",
  },
  {
    step: "02",
    title: "Agents execute through controlled lanes",
    body: "Work moves through structured lanes — analysis, valuation, review, benchmarking, dataset grading, decision support — not loose chatbot output.",
  },
  {
    step: "03",
    title: "Evidence, math, and code checks are applied",
    body: "Outputs are tested against source evidence, formulas, schemas, thresholds, policy rules, and executable validation logic before anything is trusted.",
  },
  {
    step: "04",
    title: "Verdicts separate pass, fail, risk, and repair",
    body: "The system doesn't just produce an answer. It classifies the work: what passed, what failed, what needs human review, and what should be repaired or rejected.",
  },
  {
    step: "05",
    title: "Human authority signs the final trust decision",
    body: "DefendableOS preserves operator control. The system verifies, scores, and issues receipts — but final approval stays with the human or business authority.",
  },
];

const outputs = [
  {
    title: "Execution Trail",
    body: "A structured trail of the original request, inputs, agent actions, tools used, evidence reviewed, checks performed, and the final outcome.",
  },
  {
    title: "Verification Receipt",
    body: "A portable receipt showing what passed, what failed, what was flagged, what was repaired, and what was approved.",
  },
  {
    title: "Verdict Package",
    body: "A human-readable judgment layer: retained, rejected, escalated, repaired, approved, or not defendable.",
  },
  {
    title: "Evidence Bundle",
    body: "The source materials, observations, benchmarks, files, outputs, hashes, and supporting context behind the run.",
  },
  {
    title: "Exportable Proof Artifact",
    body: "A PDF, JSON, API response, ledger entry, booklet, deed, benchmark report, dataset receipt, or client-facing package.",
  },
  {
    title: "Early-Warning & Repair Signal",
    body: "Weak or failing runs are flagged before they reach a decision, paired with a repair path, and captured as proprietary datasets you own — so the system gets stronger every time it's wrong.",
  },
];

const audiences = [
  {
    title: "Founders & operators",
    body: "You've put AI to work in the business. You need to know — and show — that it's actually doing the job.",
  },
  {
    title: "Operations & compliance",
    body: "When someone asks what the AI did and why, you have a straight answer with evidence behind it.",
  },
  {
    title: "Finance & the board",
    body: "Before AI work counts toward a number or a decision, it has proof that holds up under review.",
  },
];
---

<Layout path="/">
  <Nav />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-white/5">
      <div class="absolute inset-0 brand-grid" aria-hidden="true"></div>
      <div class="absolute inset-0 brand-glow" aria-hidden="true"></div>
      <div class="reveal relative mx-auto max-w-3xl px-6 py-24 text-center md:py-28">
        <p class="text-sm font-medium uppercase tracking-widest text-honey-300">
          Proof of Execution
        </p>
        <h1
          class="mt-5 text-4xl font-semibold leading-[1.1] tracking-tight text-paper md:text-6xl"
        >
          DefendableOS is <span class="font-serif italic text-honey-200">Proof of Execution</span> for
          agentic work.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-paper/70">
          It turns AI runs into verifiable execution trails: inputs, tools, evidence, checks,
          approvals, verdicts, and receipts.
        </p>
        <p class="mt-4 text-base font-medium text-paper/85">
          No black box. No loose claims. Just defensible AI execution.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="rounded-md bg-honey-300 px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-honey-200"
          >
            Make the dial
          </a>
          <a
            href="#what"
            class="rounded-md border border-white/10 px-6 py-3 text-sm font-medium text-paper/80 transition-colors hover:border-white/25 hover:text-paper"
          >
            See how it works
          </a>
        </div>
      </div>
    </section>

    <!-- The problem -->
    <Section class="border-b border-white/5">
      <div class="reveal mx-auto max-w-3xl text-center">
        <p class="text-sm font-medium uppercase tracking-widest text-honey-300">The problem</p>
        <p class="mt-5 text-2xl font-medium leading-snug text-paper md:text-3xl">
          “We're using AI in the business — but we can't prove what it did, why it did it, whether
          it worked, or what happened when it didn't.”
        </p>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-paper/70">
          AI is making real decisions and producing real work. When someone asks you to stand
          behind it, a screenshot of a chat isn't an answer. DefendableOS is.
        </p>
      </div>
    </Section>

    <!-- What it is -->
    <Section
      id="what"
      eyebrow="What it is"
      title="A verification layer for everything your agents do."
      intro="DefendableOS sits alongside the AI you already run. It doesn't replace your agents or your tools. It makes their work verifiable: tested against evidence, math, and code, run through review logic, and signed off by a person."
      class="border-b border-white/5"
    >
      <div class="reveal mx-auto mt-8 max-w-2xl space-y-4 text-center text-lg leading-relaxed text-paper/70">
        <p>
          This isn't a filing cabinet. Work goes in. Evidence, math, and code test it. Review logic
          applies. A verdict comes out — and a human owner has the final word.
        </p>
        <p>
          The result is something you've never had for AI before: a clear, checkable answer to
          “what did it do, and can we stand behind it?”
        </p>
      </div>
    </Section>

    <!-- How it works -->
    <Section
      id="how"
      eyebrow="How it works"
      title="The system logic, end to end."
      intro="Five stages, inputs to authority. Plain enough to explain to your board, strict enough to hold up when it matters."
      class="border-b border-white/5"
    >
      <ol
        class="reveal mx-auto mt-10 max-w-3xl divide-y divide-white/8 overflow-hidden rounded-xl border border-white/8 bg-white/[0.02]"
      >
        {
          steps.map((s) => (
            <li class="flex gap-5 p-6 text-left transition-colors hover:bg-white/[0.03] md:gap-6 md:p-7">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-honey-400/40 bg-honey-300/10 font-mono text-sm font-semibold text-honey-200">
                {s.step}
              </span>
              <div>
                <h3 class="text-base font-semibold text-paper md:text-lg">{s.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-paper/65">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </Section>

    <!-- Outputs -->
    <Section
      id="outputs"
      eyebrow="Outputs"
      title="Proof you can put in front of anyone."
      intro="Every DefendableOS run can produce a complete, portable proof set — from the full execution trail to a client-ready artifact."
      class="border-b border-white/5"
    >
      <div class="mx-auto mt-10 grid max-w-5xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {outputs.map((o) => <ValueCard title={o.title} body={o.body} />)}
      </div>
    </Section>

    <!-- Who it's for -->
    <Section
      id="who"
      eyebrow="Who it's for"
      title="For operators who are accountable for what their AI does."
      class="border-b border-white/5"
    >
      <div class="mx-auto mt-10 grid max-w-5xl gap-5 md:grid-cols-3">
        {audiences.map((a) => <ValueCard title={a.title} body={a.body} />)}
      </div>
    </Section>

    <!-- Closing CTA -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 brand-glow" aria-hidden="true"></div>
      <div class="reveal relative mx-auto max-w-2xl px-6 py-20 text-center md:py-24">
        <h2 class="text-3xl font-semibold tracking-tight text-paper md:text-4xl">
          If AI is doing the work, you should be able to defend it.
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-paper/70">
          Tell us where AI is running in your business. We'll show you what it would take to put a
          proof layer behind it.
        </p>
        <div class="mt-9">
          <a
            href="/contact"
            class="inline-block rounded-md bg-honey-300 px-7 py-3.5 text-sm font-semibold text-ink transition-colors hover:bg-honey-200"
          >
            Make the dial
          </a>
        </div>
      </div>
    </section>

    <!-- Signature · to the shed -->
    <div class="border-t border-white/5">
      <p
        class="mx-auto max-w-container px-6 py-8 text-center font-mono text-xs uppercase tracking-[0.35em] text-honey-300/55"
      >
        // to the shed
      </p>
    </div>
  </main>

  <Footer />
</Layout>
