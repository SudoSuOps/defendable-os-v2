---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const email = "build@swarmandbee.ai";
const subject = encodeURIComponent("DefendableOS — let's talk");
const body = encodeURIComponent(
  "Where AI is running in our business:\n\nWhat we need to prove:\n\nBest way to reach us:\n",
);
const mailto = `mailto:${email}?subject=${subject}&body=${body}`;
---

<Layout
  path="/contact"
  title="Contact · DefendableOS"
  description="Tell us where AI is running in your business and what you need to prove. Reach DefendableOS at build@swarmandbee.ai."
>
  <Nav />

  <main>
    <section class="relative overflow-hidden border-b border-white/5">
      <div class="absolute inset-0 brand-grid" aria-hidden="true"></div>
      <div class="reveal relative mx-auto max-w-2xl px-6 py-20 text-center md:py-24">
        <p class="text-sm font-medium uppercase tracking-widest text-honey-300">Contact</p>
        <h1 class="mt-5 text-4xl font-semibold tracking-tight text-paper md:text-5xl">
          Make the dial.
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-paper/70">
          The fastest way to start is a straight conversation. Tell us where AI is running in your
          business and what you need to be able to prove. We'll tell you plainly whether
          DefendableOS is a fit.
        </p>

        <div class="mt-10">
          <a
            href={mailto}
            class="inline-block rounded-md bg-honey-300 px-7 py-3.5 text-sm font-semibold text-ink transition-colors hover:bg-honey-200"
          >
            Email {email}
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-6 py-16 md:py-20">
      <div class="reveal grid gap-10 text-left md:grid-cols-2">
        <div>
          <h2 class="text-xl font-semibold text-paper">What to include</h2>
          <ul class="mt-4 space-y-3 text-paper/70">
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-honey-300"></span>
              <span>Where AI is doing real work in your business today.</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-honey-300"></span>
              <span>What you need to be able to prove — and to whom.</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-honey-300"></span>
              <span>The best way and time to reach you.</span>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-paper">What happens next</h2>
          <p class="mt-4 leading-relaxed text-paper/70">
            We read every note ourselves. If there's a fit, you'll hear back from a person — not a
            sequence — with a clear read on whether we can put a proof layer behind your AI work,
            and what that would take.
          </p>
          <p class="mt-6 text-sm text-paper/50">
            Swarm and Bee LLC · DBA Swarm &amp; Bee AI · Florida · D-U-N-S 138652395
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
